FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=請替換為足夠長的隨機字串
# 相對 SQLite URL 由 Flask instance path 解析，因此不要再加 instance/。
DATABASE_URL=sqlite:///dorm_staff.db
SESSION_TIMEOUT_MINUTES=30
SESSION_TYPE=cachelib
SESSION_COOKIE_SECURE=0
ATTENDANCE_ENABLED=1
# HTTPS or ENCRYPTED_HTTP. Use ENCRYPTED_HTTP only for the attendance API on a trusted LAN.
ATTENDANCE_TRANSPORT_MODE=HTTPS
# Backward-compatible guard for HTTPS mode.
ATTENDANCE_REQUIRE_HTTPS=1
NOTIFICATION_SYNC_INTERVAL_SECONDS=120
# 只有確定由 Apache 反向代理時才設為 1。
TRUST_PROXY=0
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
MAX_UPLOAD_BYTES=8388608
MAX_REQUEST_UPLOAD_BYTES=20971520
DOCUMENT_MAX_PIXELS=20000000
DOCUMENT_STORAGE_DIR=instance/private_documents
DOCUMENT_KEY_DIR=instance/private_keys
DOCUMENT_KEY_BACKUP_DIR=instance/private_keys/backup
# 可留空，由系統首次啟動自動產生主金鑰與備份；若手動設定，必須與既有金鑰檔一致。
DOCUMENT_ENCRYPTION_KEY=
# 管理員尚未儲存政策前的預設值；0 代表不自動清理。
DOCUMENT_DEFAULT_RETENTION_DAYS=365
DOCUMENT_CLEANUP_SCHEDULER_ENABLED=1
DOCUMENT_CLEANUP_CHECK_SECONDS=300
# 單一維護排程器同時負責文件清理與完整備份，跨程序鎖可避免重複執行。
MAINTENANCE_SCHEDULER_ENABLED=1
MAINTENANCE_CHECK_SECONDS=300
AUTOMATIC_BACKUP_ENABLED=1
AUTOMATIC_BACKUP_HOUR=2
AUTOMATIC_BACKUP_MINUTE=0
AUTOMATIC_BACKUP_RETENTION_DAYS=30
# 正式環境建議改成受 BitLocker 保護的另一顆磁碟或備份磁碟。
AUTOMATIC_BACKUP_DIR=instance/automatic_backups
